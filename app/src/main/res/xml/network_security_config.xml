<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Disable cleartext HTTP across the entire app by default.
    -->
    <base-config cleartextTrafficPermitted="false" />

    <!--
        The router's web interface is plain HTTP on the local network (no TLS available on the device).
        Permit cleartext only for standard router gateway IPs and local domain names.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Standard router gateway IP addresses -->
        <domain includeSubdomains="false">192.168.1.1</domain>
        <domain includeSubdomains="false">192.168.0.1</domain>
        <domain includeSubdomains="false">192.168.2.1</domain>
        <domain includeSubdomains="false">192.168.1.254</domain>
        <domain includeSubdomains="false">192.168.100.1</domain>
        <domain includeSubdomains="false">10.0.0.1</domain>
        <domain includeSubdomains="false">172.16.0.1</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>

        <!-- Local domain names and TP-Link local hostnames -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="true">local</domain>
        <domain includeSubdomains="true">lan</domain>
        <domain includeSubdomains="true">home.arpa</domain>
        <domain includeSubdomains="false">tplinkwifi.net</domain>
        <domain includeSubdomains="false">tplinklogin.net</domain>
    </domain-config>
</network-security-config>
